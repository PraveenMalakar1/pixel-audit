{
  "name": "visual-qa-server",
  "version": "0.1.0",
  "description": "MCP server that compares a live web page against its Figma design and paints the differences.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "visual-qa-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "smoke": "node dist/scripts/smoke.js",
    "mcp-check": "node dist/scripts/mcp-check.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "culori": "^4.0.2",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
